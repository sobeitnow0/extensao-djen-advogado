{
  "manifest_version": 3,
  "name": "Buscador DJEN",
  "version": "1.3.0",
  "description": "Consulta rápida de intimações no DJEN. Interface premium, filtros por tribunal, contagem de prazos e exportação estruturada.",
  "author": "Amilcar Moreira",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://comunicaapi.pje.jus.br/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Abrir Buscador DJEN",
    "default_icon": {
      "16": "djen-16.png",
      "48": "djen-48.png",
      "128": "djen-128.png"
    }
  },
  "icons": {
    "16": "djen-16.png",
    "48": "djen-48.png",
    "128": "djen-128.png"
  }
}
