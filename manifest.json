{
  "manifest_version": 3,
  "name": "Buscador DJEN",
  "version": "3.3.0",
  "description": "Consulta minimalista de intimações. Interface Adwaita (GNOME Style) com limpeza editorial, busca dinâmica e contador de resultados.",
  "author": "Amilcar Moreira",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://comunicaapi.pje.jus.br/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Abrir Buscador DJEN",
    "default_icon": {
      "16": "djen-16.png",
      "48": "djen-48.png",
      "128": "djen-128.png"
    }
  },
  "icons": {
    "16": "djen-16.png",
    "48": "djen-48.png",
    "128": "djen-128.png"
  }
}
