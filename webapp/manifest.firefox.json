{
    "manifest_version": 3,
    "name": "Buscador DJEN - Prazos e Intimações Judiciais",
    "version": "50.74",
    "description": "Buscador de Intimações com Motor de Prazos Avançado.",
    "author": "Amilcar Moreira",
    "permissions": [
        "clipboardWrite",
        "alarms",
        "downloads",
        "notifications",
        "identity"
    ],
    "host_permissions": [
        "https://comunicaapi.pje.jus.br/*",
        "https://raw.githubusercontent.com/*",
        "https://api-publica.datajud.cnj.jus.br/*",
        "https://tasks.googleapis.com/*",
        "https://accounts.google.com/*",
        "https://www.googleapis.com/*",
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "fonts/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "background": {
        "scripts": [
            "djen_storage.js",
            "background.js"
        ]
    },
    "action": {
        "default_title": "Abrir Buscador DJEN",
        "default_icon": "djen-48.png"
    },
    "sidebar_action": {
        "default_panel": "sidebar.html",
        "default_title": "Buscador DJEN",
        "default_icon": "djen-48.png"
    },
    "icons": {
        "16": "djen-16.png",
        "48": "djen-48.png",
        "128": "djen-128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "djen@sobeitnow0.github.io",
            "strict_min_version": "109.0"
        }
    },
    "version_name": "50.74"
}