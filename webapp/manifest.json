{
  "manifest_version": 3,
  "name": "Buscador DJEN - Prazos e Intimações Judiciais",
  "version": "50.3",
  "description": "Buscador de Intimações com Motor de Prazos Avançado.",
  "author": "Amilcar Moreira",
  "permissions": [
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": [
    "https://comunicaapi.pje.jus.br/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Buscador DJEN",
    "default_icon": "djen-48.png"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "icons": {
    "16": "djen-16.png",
    "48": "djen-48.png",
    "128": "djen-128.png"
  }
}
