{
    "manifest_version": 3,
    "name": "Buscador DJEN - Prazos e Intimações Judiciais",
    "version": "50.74",
    "description": "Buscador de Intimações com Motor de Prazos Avançado.",
    "author": "Amilcar Moreira",
    "permissions": [
        "clipboardWrite",
        "sidePanel",
        "alarms",
        "downloads",
        "notifications",
        "identity"
    ],
    "host_permissions": [
        "https://comunicaapi.pje.jus.br/*",
        "https://raw.githubusercontent.com/*",
        "https://api-publica.datajud.cnj.jus.br/*",
        "https://tasks.googleapis.com/*",
        "https://accounts.google.com/*",
        "https://www.googleapis.com/*",
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "fonts/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Abrir Buscador DJEN",
        "default_icon": "djen-48.png"
    },
    "side_panel": {
        "default_path": "sidebar.html"
    },
    "icons": {
        "16": "djen-16.png",
        "48": "djen-48.png",
        "128": "djen-128.png"
    },
    "version_name": "50.74"
}